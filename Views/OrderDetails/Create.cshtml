@model OrderDetail
@{
    ViewData["Title"] = "Add Order Item";
}

<div class="pt-3 pb-2 mb-4 border-bottom">
    <h1 class="h2">Add Item to Order #@Model.OrderID</h1>
</div>

<div class="card shadow-sm border-0 w-50">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="OrderID" />
            
            <div class="mb-3">
                <label asp-for="BatchID" class="form-label fw-bold"></label>
                <select asp-for="BatchID" class="form-select" asp-items="ViewBag.Batches">
                    <option value="">-- Select Harvest Batch --</option>
                </select>
                <span asp-validation-for="BatchID" class="text-danger"></span>
            </div>
            
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Quantity" class="form-label fw-bold"></label>
                    <input asp-for="Quantity" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="UnitPrice" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>
            </div>
            
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Add Item</button>
                <a asp-action="Index" asp-route-orderId="@Model.OrderID" class="btn btn-outline-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
