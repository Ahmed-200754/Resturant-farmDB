@model IEnumerable<OrderDetail>
@{
    ViewData["Title"] = "Order Details";
    int orderId = ViewBag.OrderID;
    double orderTotal = Model.Sum(x => x.LineTotal);
}

<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-4 border-bottom">
    <h1 class="h2">Items for Order #@orderId</h1>
    <div>
        <a asp-action="Create" asp-route-orderId="@orderId" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Item</a>
        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary ms-2"><i class="bi bi-arrow-left me-1"></i> Back to Orders</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Crop (Batch)</th>
                                <th>Farm</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Line Total</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model ?? new List<OrderDetail>())
                            {
                                <tr>
                                    <td><span class="fw-bold">@item.CropName</span> <small class="text-muted">(Batch #@item.BatchID)</small></td>
                                    <td>@item.FarmName</td>
                                    <td>@item.Quantity</td>
                                    <td>$@item.UnitPrice.ToString("N2")</td>
                                    <td class="fw-bold">$@item.LineTotal.ToString("N2")</td>
                                    <td class="text-end">
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.OrderDetailID" />
                                            <input type="hidden" name="orderId" value="@orderId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this item?');">
                                                <i class="bi bi-x-circle"></i> Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if(!Model.Any()) {
                                <tr><td colspan="6" class="text-center">No items added to this order yet.</td></tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="4" class="text-end">Order Total:</th>
                                <th colspan="2" class="text-success fs-5">$@orderTotal.ToString("N2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
