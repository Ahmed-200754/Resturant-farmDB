@model IEnumerable<TripToRestaurant>
@{
    ViewData["Title"] = "Trips";
}

<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-4 border-bottom">
    <h1 class="h2">Delivery Trips</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Log New Trip</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Trip ID</th>
                        <th>Date</th>
                        <th>Driver</th>
                        <th>Farm Origin</th>
                        <th>Route</th>
                        <th>Distance</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model ?? new List<TripToRestaurant>())
                    {
                        <tr>
                            <td>#@item.TripID</td>
                            <td>@item.TripDate.ToShortDateString()</td>
                            <td class="fw-bold">@item.DriverName</td>
                            <td>@item.FarmName</td>
                            <td>@item.RouteTaken</td>
                            <td><span class="badge bg-secondary rounded-pill">@item.Distance km</span></td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.TripID" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.TripID">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="deleteModal-@item.TripID" tabindex="-1" aria-hidden="true">
                                  <div class="modal-dialog">
                                    <div class="modal-content">
                                      <div class="modal-header">
                                        <h5 class="modal-title">Confirm Delete</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body">
                                        Are you sure you want to delete Trip <strong>#@item.TripID</strong>?
                                      </div>
                                      <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="Delete" asp-route-id="@item.TripID" method="post">
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any()) {
                        <tr><td colspan="7" class="text-center">No trips found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
