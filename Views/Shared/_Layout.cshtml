<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Farm Hub</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --agri-bg: #111312;
            --agri-surface: #181b19;
            --agri-surface-hover: #1e221f;
            --agri-border: #2a2d2b;
            --agri-primary: #9bd9b5;
            --agri-primary-hover: #83cba0;
            --agri-primary-dim: #1d4231;
            --agri-text-main: #d5d8d6;
            --agri-text-muted: #838986;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--agri-bg);
            color: var(--agri-text-main);
        }

        /* Typography overrides */
        h1, h2, h3, h4, h5, h6 {
            color: white;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        /* Buttons */
        .btn-primary {
            background-color: var(--agri-primary);
            border-color: var(--agri-primary);
            color: #0b1a13;
            font-weight: 600;
        }
        .btn-primary:hover {
            background-color: var(--agri-primary-hover);
            border-color: var(--agri-primary-hover);
            color: #0b1a13;
        }
        .btn-outline-primary {
            color: var(--agri-primary);
            border-color: var(--agri-primary);
        }
        .btn-outline-primary:hover {
            background-color: var(--agri-primary-dim);
            color: var(--agri-primary);
            border-color: var(--agri-primary);
        }

        /* Sidebar */
        .sidebar {
            min-height: calc(100vh - 70px);
            background-color: var(--agri-surface);
            border-right: 1px solid var(--agri-border);
        }
        .sidebar .nav-link {
            color: var(--agri-text-muted);
            font-weight: 500;
            padding: 0.8rem 1.5rem;
            margin-bottom: 0.2rem;
            transition: all 0.2s ease;
        }
        .sidebar .nav-link:hover {
            background-color: var(--agri-surface-hover);
            color: white;
        }
        .sidebar .nav-link.active-link {
            background-color: var(--agri-primary-dim);
            color: var(--agri-primary) !important;
            border-radius: 0.5rem;
            border-left: 3px solid var(--agri-primary);
        }

        /* Navbar */
        .navbar {
            background-color: var(--agri-bg) !important;
            border-bottom: 1px solid var(--agri-border);
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
        .navbar-brand {
            color: var(--agri-primary) !important;
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: -0.03em;
        }
        .navbar-brand span {
            color: var(--agri-text-main);
            font-weight: 400;
            font-size: 0.8rem;
            letter-spacing: 0.1em;
            display: block;
            margin-top: -0.4rem;
        }

        /* Cards */
        .card {
            background-color: var(--agri-surface);
            border: 1px solid var(--agri-border);
            border-radius: 0.75rem;
        }
        .card-header {
            background-color: transparent;
            border-bottom: 1px solid var(--agri-border);
            color: white;
            font-weight: 600;
        }
        
        /* Tables */
        .table {
            color: var(--agri-text-main);
            border-color: var(--agri-border);
        }
        .table>thead {
            background-color: var(--agri-surface-hover);
        }
        .table>thead th {
            color: var(--agri-text-muted);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: none;
            padding: 1rem;
        }
        .table>tbody>tr>td {
            border-bottom-color: var(--agri-border);
            padding: 1rem;
            vertical-align: middle;
        }
        .table-hover>tbody>tr:hover>* {
            color: white;
            background-color: var(--agri-surface-hover);
        }

        /* Badges */
        .badge {
            font-weight: 600;
            padding: 0.4em 0.8em;
            border-radius: 0.4rem;
        }
        .bg-success { background-color: var(--agri-primary-dim) !important; color: var(--agri-primary) !important; }
        .text-success { color: var(--agri-primary) !important; }

        /* Main */
        .main-content {
            padding: 2.5rem;
        }
        
        /* Inputs */
        .form-control, .form-select {
            background-color: var(--agri-bg);
            border: 1px solid var(--agri-border);
            color: white;
        }
        .form-control:focus, .form-select:focus {
            background-color: var(--agri-bg);
            border-color: var(--agri-primary);
            box-shadow: 0 0 0 0.25rem rgba(155, 217, 181, 0.25);
            color: white;
        }
    </style>
</head>
<body>
    <partial name="_Navbar" />

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3 col-lg-2 p-0">
                <partial name="_Sidebar" />
            </div>
            
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Toasts for messages -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast align-items-center text-bg-dark border border-success show" role="alert" aria-live="assertive" aria-atomic="true">
              <div class="d-flex">
                <div class="toast-body text-success fw-bold">
                  <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
              </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast align-items-center text-bg-dark border border-danger show" role="alert" aria-live="assertive" aria-atomic="true">
              <div class="d-flex">
                <div class="toast-body text-danger fw-bold">
                  <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
              </div>
            </div>
        }
    </div>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        $(document).ready(function() {
            var toasts = document.querySelectorAll('.toast');
            toasts.forEach(function(t) {
                var toast = new bootstrap.Toast(t);
                toast.show();
            });
        });
    </script>
</body>
</html>
