@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    
    string FormatMoney(double amount) {
        if (amount >= 1000000) return "$" + (amount / 1000000).ToString("0.##") + "M";
        if (amount >= 1000) return "$" + (amount / 1000).ToString("0.##") + "k";
        return "$" + amount.ToString("N2");
    }
}

<div class="d-flex justify-content-between align-items-end pt-2 pb-3 mb-4">
    <div>
        <h1 class="h2 mb-1" style="font-family: 'Inter', sans-serif;">Executive Overview</h1>
        <p class="text-muted mb-0">Regional Agri-Intel & Distribution Control</p>
    </div>
    <div class="d-flex gap-3">
        <button class="btn btn-sm" style="background-color: var(--agri-surface); color: var(--agri-primary); border: 1px solid var(--agri-border);">
            <i class="bi bi-broadcast me-2"></i> Real-time Operations
        </button>
        <button class="btn btn-sm btn-outline-secondary text-white border-secondary">
            Generate Report
        </button>
    </div>
</div>

@if (ViewBag.DbError != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Database Error:</strong> @ViewBag.DbError
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- TOP STATS ROW -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100 p-3 border-0" style="background-color: var(--agri-surface);">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="rounded p-2 d-flex align-items-center justify-content-center" style="background-color: var(--agri-primary-dim); width: 32px; height: 32px;">
                    <i class="bi bi-cash-stack text-success"></i>
                </div>
                <span class="badge" style="background-color: var(--agri-primary-dim); color: var(--agri-primary);">+12.4%</span>
            </div>
            <p class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">TOTAL REVENUE</p>
            <h2 class="mb-2">@FormatMoney(Model.TotalRevenue)</h2>
            <div class="progress mt-auto" style="height: 4px; background-color: var(--agri-bg);">
                <div class="progress-bar bg-success" role="progressbar" style="width: 75%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100 p-3 border-0" style="background-color: var(--agri-surface);">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="rounded p-2 d-flex align-items-center justify-content-center" style="background-color: var(--agri-surface-hover); width: 32px; height: 32px;">
                    <i class="bi bi-box-seam text-white"></i>
                </div>
                <span class="text-muted" style="font-size: 0.75rem;">@Model.TotalActiveBatches Total</span>
            </div>
            <p class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">ACTIVE BATCHES</p>
            <h2 class="mb-2">@Model.TotalActiveBatches</h2>
            <div class="d-flex gap-1 mt-auto">
                <div class="progress flex-grow-1" style="height: 4px; background-color: var(--agri-bg);">
                    <div class="progress-bar bg-success" style="width: 100%"></div>
                </div>
                <div class="progress flex-grow-1" style="height: 4px; background-color: var(--agri-bg);">
                    <div class="progress-bar bg-success" style="width: 100%"></div>
                </div>
                <div class="progress flex-grow-1" style="height: 4px; background-color: var(--agri-bg);">
                    <div class="progress-bar bg-secondary" style="width: 100%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100 p-3 border-0" style="background-color: var(--agri-surface);">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="rounded p-2 d-flex align-items-center justify-content-center" style="background-color: rgba(220, 53, 69, 0.15); width: 32px; height: 32px;">
                    <i class="bi bi-exclamation-triangle text-danger"></i>
                </div>
                <span class="text-danger" style="font-size: 0.75rem;">Urgent</span>
            </div>
            <p class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">EXPIRING BATCHES</p>
            <h2 class="mb-2 text-danger">@Model.ExpiringBatches.Count()</h2>
            <p class="text-muted mb-0 mt-auto" style="font-size: 0.75rem;">
                <i class="bi bi-graph-up-arrow me-1"></i> Expires < 7 Days
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100 p-3 border-0" style="background-color: var(--agri-surface);">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="rounded p-2 d-flex align-items-center justify-content-center" style="background-color: var(--agri-primary-dim); width: 32px; height: 32px;">
                    <i class="bi bi-star text-success"></i>
                </div>
                <span class="badge" style="background-color: var(--agri-primary-dim); color: var(--agri-primary);">Rank #1</span>
            </div>
            <p class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">TOP FARM</p>
            @if(Model.TopPerformingFarms != null && Model.TopPerformingFarms.Any()) {
                var topFarm = Model.TopPerformingFarms.First();
                <h3 class="mb-2 fs-4 text-truncate">@topFarm.FarmName</h3>
                <p class="text-success mb-0 mt-auto" style="font-size: 0.75rem;">
                    @FormatMoney(topFarm.TotalRevenue) generated
                </p>
            } else {
                <h3 class="mb-2 fs-4 text-muted">No Data</h3>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Main Logistics/Orders Area -->
    <div class="col-lg-8">
        <div class="card border-0 h-100" style="background-color: var(--agri-surface);">
            <div class="card-header border-0 pb-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 text-white">Recent Order Manifests</h5>
                    <p class="text-muted" style="font-size: 0.8rem;">Distribution flow execution</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill bg-dark border border-secondary text-muted"><i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem;"></i> Live</span>
                </div>
            </div>
            <div class="card-body px-4">
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle mb-0">
                        <thead style="background-color: transparent; border-bottom: 1px solid var(--agri-border);">
                            <tr>
                                <th class="ps-0">ORDER REF</th>
                                <th>DESTINATION</th>
                                <th>DATE</th>
                                <th>STATUS</th>
                                <th class="text-end pe-0">TOTAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var order in Model.RecentOrders ?? new List<Order>())
                            {
                                <tr style="border-bottom: 1px solid var(--agri-border);">
                                    <td class="ps-0 fw-medium text-white">#@order.OrderID</td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="text-white">@order.RestaurantName</span>
                                        </div>
                                    </td>
                                    <td class="text-muted">@order.OrderDate.ToShortDateString()</td>
                                    <td>
                                        <span class="badge bg-dark border border-secondary text-muted">Active</span>
                                    </td>
                                    <td class="text-end pe-0 text-white fw-bold">@FormatMoney(order.TotalValue)</td>
                                </tr>
                            }
                            @if(!(Model.RecentOrders ?? new List<Order>()).Any()) {
                                <tr><td colspan="5" class="text-muted text-center py-4">No recent orders found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Insights / Expiring -->
    <div class="col-lg-4">
        <div class="card border-0 mb-4" style="background-color: var(--agri-surface);">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-stars fs-4 text-success me-2"></i>
                    <h5 class="mb-0 text-white">Smart AI Insights</h5>
                </div>
                <p class="text-muted" style="font-size: 0.85rem;">
                    AgriIntel's neural core has analyzed regional crop demand trends. Predictive models suggest a significant shift in restaurant sourcing patterns.
                </p>
                <a href="#" class="text-success text-decoration-none fw-medium" style="font-size: 0.85rem;">Review Prediction Model <i class="bi bi-arrow-right"></i></a>
                
                <div class="mt-4 pt-3 border-top" style="border-color: var(--agri-border) !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <p class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">RISING DEMAND</p>
                            <h6 class="text-white mb-0">Heirloom Tomatoes</h6>
                            <small class="text-success">+24% predicted demand</small>
                        </div>
                        <div class="rounded p-2" style="background-color: var(--agri-surface-hover);">
                            <i class="bi bi-graph-up text-muted"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card border-0" style="background-color: var(--agri-surface);">
            <div class="card-header border-0 pb-0 pt-4 px-4">
                <h5 class="mb-0 text-white">Expiring Inventory Alerts</h5>
            </div>
            <div class="card-body px-4">
                @foreach (var batch in (Model.ExpiringBatches ?? new List<HarvestBatch>()).Take(3))
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom py-3" style="border-color: var(--agri-border) !important;">
                        <div>
                            <h6 class="text-white mb-1">@batch.CropName <span class="text-muted ms-1 fw-normal">#@batch.BatchID</span></h6>
                            <small class="text-muted"><i class="bi bi-geo-alt"></i> @batch.FarmName</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 mb-1">
                                @((batch.FreshnessWindow - DateTime.Today).Days) Days
                            </span>
                            <div class="text-white fw-bold" style="font-size: 0.85rem;">@batch.Quantity kg</div>
                        </div>
                    </div>
                }
                @if(!(Model.ExpiringBatches ?? new List<HarvestBatch>()).Any()) {
                    <p class="text-muted text-center my-3">Inventory is optimal. No expiring batches.</p>
                }
            </div>
        </div>
    </div>
</div>
