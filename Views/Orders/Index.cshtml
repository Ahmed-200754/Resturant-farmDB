@model IEnumerable<Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-4 border-bottom">
    <h1 class="h2">Orders</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Create New Order</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Restaurant</th>
                        <th>Order Date</th>
                        <th>Total Items</th>
                        <th>Total Value</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model ?? new List<Order>())
                    {
                        <tr>
                            <td><span class="fw-bold">#@item.OrderID</span></td>
                            <td class="fw-medium">@item.RestaurantName</td>
                            <td>@item.OrderDate.ToShortDateString()</td>
                            <td><span class="badge bg-secondary rounded-pill">@item.TotalItems items</span></td>
                            <td><span class="text-success fw-bold">$@item.TotalValue.ToString("N2")</span></td>
                            <td class="text-end">
                                <a asp-controller="OrderDetails" asp-action="Index" asp-route-orderId="@item.OrderID" class="btn btn-sm btn-outline-primary"><i class="bi bi-list-ul me-1"></i> Details</a>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.OrderID">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="deleteModal-@item.OrderID" tabindex="-1" aria-hidden="true">
                                  <div class="modal-dialog">
                                    <div class="modal-content">
                                      <div class="modal-header">
                                        <h5 class="modal-title">Confirm Delete</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body">
                                        Are you sure you want to delete Order <strong>#@item.OrderID</strong> and all its items?
                                      </div>
                                      <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="Delete" asp-route-id="@item.OrderID" method="post">
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if(Model == null || !Model.Any()) {
                        <tr><td colspan="6" class="text-center">No orders found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
