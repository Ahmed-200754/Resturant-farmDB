@model IEnumerable<Farm>
@{
    ViewData["Title"] = "Farms";
}

<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-4 border-bottom">
    <h1 class="h2">Farms</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add New Farm</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6 col-lg-4">
                <input type="text" id="farmSearch" class="form-control" placeholder="Search by farm or farmer name...">
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="farmsTable">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Farm Name</th>
                        <th>Farmer Name</th>
                        <th>Phone</th>
                        <th>Location (Lat, Long)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model ?? new List<Farm>())
                    {
                        <tr>
                            <td>@item.FarmID</td>
                            <td class="fw-bold">@item.FarmName</td>
                            <td>@item.FarmerName</td>
                            <td>@item.FarmerPhone</td>
                            <td><small class="text-muted">@item.Latitude, @item.Longitude</small></td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.FarmID" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.FarmID">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="deleteModal-@item.FarmID" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                                  <div class="modal-dialog">
                                    <div class="modal-content">
                                      <div class="modal-header">
                                        <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                      </div>
                                      <div class="modal-body">
                                        Are you sure you want to delete the farm <strong>@item.FarmName</strong>?
                                      </div>
                                      <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="Delete" asp-route-id="@item.FarmID" method="post">
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if(Model == null || !Model.Any()) {
                        <tr><td colspan="6" class="text-center">No farms found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function(){
            $("#farmSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#farmsTable tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
